generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  username      String?    @unique
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Make optional for OAuth users
  role          String?    @default("CHILD") // "CHILD" | "PARENT" | "ADMIN"
  onboarded     Boolean  @default(false)
  
  // Self-relation for parent-child linking
  parentId  String?
  parent    User?    @relation("ParentChildren", fields: [parentId], references: [id])
  children  User[]   @relation("ParentChildren")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  diaryEntries DiaryEntry[]
  goals        Goal[]
  sentReviews  Review[]     @relation("SentReviews")
  receivedReviews Review[]  @relation("ReceivedReviews")
  profile      Profile?
  accounts     Account[]
  sessions     Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Personal Info
  realName       String?
  fathersName    String?
  mothersName    String?
  dob            String?
  school         String?
  bloodGroup     String?
  zodiacSign     String?
  address        String?
  
  // Favorites
  favColor       String?
  favColorCode   String?
  favFood        String?
  favPlace       String?
  favBook        String?
  hobbies     String?
  personalGoals  String?
  
  picture        String?  // Base64 or URL
  
  updatedAt      DateTime @updatedAt
}

model DiaryEntry {
  id        String   @id @default(cuid())
  date      String   // "YYYY-MM-DD"
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json     // Activity completions
  score     Int
  rating    String
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model Goal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  childId   String
  parentId  String
  child     User     @relation("ReceivedReviews", fields: [childId], references: [id], onDelete: Cascade)
  parent    User     @relation("SentReviews", fields: [parentId], references: [id], onDelete: Cascade)
  text      String
  date      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ActivityCategory {
  id            String   @id @default(cuid())
  name          String
  pointsPerItem Int
  scoringMode   String   @default("GROUP") // "GROUP" | "INDIVIDUAL"
  userId        String?  // null for global, userId for custom
  activities    Activity[]
}

model Activity {
  id         String   @id @default(cuid())
  name       String
  points     Int?     // Individual points override
  categoryId String
  userId     String?  // null for global, userId for custom
  category   ActivityCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model UserActivityConfig {
  id         String   @id @default(cuid())
  userId     String
  activityId String
  enabled    Boolean  @default(true)
  points     Int?     // Override points if needed
  
  @@unique([userId, activityId])
}

model UserCategoryConfig {
  id            String   @id @default(cuid())
  userId        String
  categoryId    String
  enabled       Boolean  @default(true)
  pointsPerItem Int?     // Override pointsPerItem
  scoringMode   String?  // "GROUP" | "INDIVIDUAL"
  
  @@unique([userId, categoryId])
}
